# Copy to .env and fill in. Production values live in Vercel (Project > Settings
# > Environment Variables). NEXT_PUBLIC_* values are read at build time, so
# redeploy after changing them.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://vitalapp.in

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Web push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Cloudflare Turnstile (docs/MONITORING.md) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry (docs/MONITORING.md) ---
NEXT_PUBLIC_SENTRY_DSN=

# --- WhatsApp Cloud API (docs/WHATSAPP.md) ---
WHATSAPP_ENABLED=false
NEXT_PUBLIC_WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
CRON_SECRET=

# --- Optional ---
# CSP_REPORT_ONLY=true   # report CSP violations instead of blocking (debugging)
